/**
 * Assignatura 21742 - Compiladors
 * Estudis: Grau en Informàtica
 * Itinerari: Computació
 * Curs: 2025-2026
 *
 * Professor: Pere Palmer
 *
 * Generar:
 * java -jar java-cup-11b.jar -expect 16 -parser Parser -symbols ParserSym -destdir gen src/gramatica/Parser.cup
 */
import java_cup.runtime.*;
import java_cup.runtime.ComplexSymbolFactory.ComplexSymbol;
import symbols.*;
import errors.*;
import java.util.*;

class Parser;

parser code {:
    public <T> List<T> combinar(T first, List<T> rest) {
        List<T> list = new ArrayList<>();
        list.add(first);
        if (rest != null) list.addAll(rest);
        return list;
    }

    public <T> List<T> crearLlista(T item) {
        List<T> list = new ArrayList<>();
        list.add(item);
        return list;
    }
:}

terminal Symbol
            PRINCIPAL, ENDPRINCIPAL,
            OP_IF, OP_THEN, OP_ELSE, OP_ENDIF,
            OP_SWITCH, DEFAULT_SWITCH, OP_ENDSWITCH,
            OP_WHILE, OP_DO, OP_ENDWHILE,
            OP_REP, PROCEDIMENT, ENDPROCEDIMENT,
            FUNCIO, ENDFUNCIO, TORNAR, CONST,
            OP_TIPUS_CADENA, OP_TIPUS_TUPLA, OP_TIPUS_CARACTER,
            OP_TIPUS_ENTER, OP_TIPUS_LOGIC,
            PLUS, MINUS, TIMES, DIVIDE,
            EQ, NE, LT, LE, GT, GE, INPUT, OUTPUT,
            AND, OR, NOT, ASSIGNACIO, OBR_PAR,
            TANC_PAR, OBR_CORX, TANC_CORX, DOS_PUNTS,
            COMA, PUNT_COMA, PUNT, ERROR;

terminal String ID, CADENA;
terminal Character CARACTER;
terminal Double ENTER;
terminal Boolean VALOR_LOGIC;

non terminal ProgramNode program;
non terminal List<DeclNode> decls;
non terminal List<MethodNode> methods;
non terminal List<InstrNode> instrs, optional_cond;
non terminal DeclNode decl;
non terminal InstrNode instr,  entrada, sortida;
non terminal InstrNode.CallNode call;
non terminal CondNode cond;
non terminal CondNode.SwitchNode.CaseNode cas_opcio;
non terminal LoopNode loop;
non terminal MethodNode method;
non terminal TypeNode tipus;
non terminal ExprNode assig, expr, terme, index_opt;
non terminal ExprNode expr_logic, expr_rel, expr_arit;
non terminal ArgNode arg;
non terminal List<ArgNode> args;
non terminal List<CondNode.SwitchNode.CaseNode> cas_opcions;
non terminal String op_arit, op_rel, op_log;
non terminal List<ExprNode.VarNode> list_id;
non terminal List<ExprNode> expr_list;
non terminal InstrNode.AssignNode assign_instr;

// Associativitat i precedència dels operadors
precedence left OR;            // OR més baix que AND
precedence left AND;           // AND més baix que comparacions

precedence nonassoc EQ, NE, LT, LE, GT, GE;   // comparadors no associatius

precedence left PLUS, MINUS;    // suma i resta associatius a l'esquerra
precedence left TIMES, DIVIDE;  // multiplicació i divisió associatius a l'esquerra

precedence right NOT;          // negació (NOT) té associativitat a la dreta

start with program;

program ::= PRINCIPAL:p ID:id DOS_PUNTS decls:d methods:m instrs:i ENDPRINCIPAL
            {: RESULT = new ProgramNode(id, d, m, i, pleft, pright); :}
;

decls ::= decl:d decls:ds
            {: RESULT = combinar(d, ds); :}
        | /* buit */
            {: RESULT = new ArrayList<DeclNode>(); :}
;

decl ::= tipus:t list_id:l assig:a
            {: RESULT = new DeclNode(t, l, a, false, t.line, t.column); :}
        | CONST:c tipus:t list_id:l ASSIGNACIO expr:e
            {: RESULT = new DeclNode(t, l, e, true, t.line, t.column); :}
;

methods ::= method:m methods:ms
            {: RESULT = combinar(m, ms); :}
        | /* buit */
            {: RESULT = new ArrayList<MethodNode>(); :}
;

method ::= FUNCIO:f tipus:t ID:id OBR_PAR args:a TANC_PAR DOS_PUNTS instrs:i TORNAR expr:e ENDFUNCIO
            {: RESULT = new MethodNode(true, id, t, a, i, e, fleft, fright); :}
        | PROCEDIMENT:p ID:id OBR_PAR args:a TANC_PAR DOS_PUNTS instrs:i ENDPROCEDIMENT
            {: RESULT = new MethodNode(false, id, new TypeNode(TypeNode.Kind.VOID, pleft, pright),
                                      a, i, null, pleft, pright); :}
;

instrs ::= instr:i instrs:is
            {: RESULT = combinar(i, is); :}
        | /* buit */
            {: RESULT = new ArrayList<InstrNode>(); :}
;

instr ::= call:c
            {: RESULT = c; :}
        | cond:c
            {: RESULT = c; :}
        | loop:l
            {: RESULT = l; :}
        | entrada:e
            {: RESULT = e; :}
        | sortida:s
            {: RESULT = s; :}
        | assign_instr:a
            {: RESULT = a; :}
        | decl:d
            {: RESULT = new InstrNode.InstrDeclNode(d); :}
;

assign_instr ::= ID:id ASSIGNACIO expr:e
            {: RESULT = new InstrNode.AssignNode((new ExprNode.VarNode(id, idleft, idright)), e, idleft, idright); :}
;

call ::= ID:id OBR_PAR:op expr_list:e TANC_PAR
            {: RESULT = new InstrNode.CallNode(id, e, idleft, idright); :}
;

cond ::= OP_IF:op OBR_PAR expr:e TANC_PAR OP_THEN instrs:i optional_cond:o OP_ENDIF
            {: RESULT = new CondNode.IfNode(e, i, o, opleft, opright); :}
        | OP_SWITCH:op ID:id DOS_PUNTS cas_opcions:c DEFAULT_SWITCH DOS_PUNTS instrs:i OP_ENDSWITCH
            {: RESULT = new CondNode.SwitchNode(id, c, i, opleft, opright); :}
;

optional_cond ::= OP_ELSE instrs:i
            {: RESULT = i; :}
        | /* buit */
            {: RESULT = null; :}
;

cas_opcions ::= cas_opcio:c cas_opcions:cs
            {: RESULT = combinar(c, cs); :}
        | cas_opcio:c
            {: RESULT = crearLlista(c); :}
;

cas_opcio ::= terme:t DOS_PUNTS:d instrs:i
            {: RESULT = new CondNode.SwitchNode.CaseNode(t, i, t.line, t.column); :}
;

loop ::= OP_WHILE:w OBR_PAR expr:e TANC_PAR OP_DO instrs:i OP_ENDWHILE
            {: RESULT = new LoopNode.WhileNode(e, i, wleft, wright); :}
        | OP_DO:d instrs:i OP_REP OBR_PAR expr:e TANC_PAR
            {: RESULT = new LoopNode.DoWhileNode(i, e, dleft, dright); :}
;

entrada ::= INPUT:i OBR_PAR ID:id TANC_PAR
            {: RESULT = new InstrNode.InputNode(id, ileft, iright); :}
;

sortida ::= OUTPUT:o OBR_PAR expr:e TANC_PAR
            {: RESULT = new InstrNode.OutputNode(e, oleft, oright); :}
;

tipus ::= OP_TIPUS_ENTER:op
            {: RESULT = new TypeNode(TypeNode.Kind.DOUBLE, opleft, opright); :}
        | OP_TIPUS_CADENA:op
            {: RESULT = new TypeNode(TypeNode.Kind.STRING, opleft, opright); :}
        | OP_TIPUS_CARACTER:op
            {: RESULT = new TypeNode(TypeNode.Kind.CHARACTER, opleft, opright); :}
        | OP_TIPUS_LOGIC:op
            {: RESULT = new TypeNode(TypeNode.Kind.BOOLEAN, opleft, opright); :}
        | OP_TIPUS_TUPLA:op
            {: RESULT = new TypeNode(TypeNode.Kind.TUPLE, opleft, opright); :}
;

list_id ::= ID:id COMA list_id:l
            {: RESULT = combinar(new ExprNode.VarNode(id, idleft, idright), l); :}
        | ID:id
            {: RESULT = crearLlista(new ExprNode.VarNode(id, idleft, idright)); :}
;

args ::= arg:a COMA args:as
            {: RESULT = combinar(a, as); :}
        | arg: a
            {: RESULT = crearLlista(a); :}
        | /* buit */
            {: RESULT = new ArrayList<ArgNode>(); :}
;

arg ::= ID:id DOS_PUNTS tipus:t
            {: RESULT = new ArgNode(new ExprNode.VarNode(id, idleft, idright), t); :}
;

assig ::= ASSIGNACIO expr:e
            {: RESULT = e; :}
        | /* buit */
            {: RESULT = null; :}
;

expr ::= expr_logic:e
            {: RESULT = e; :}
;

expr_logic ::= expr_logic:el op_log:op expr_rel:er
            {: RESULT = new ExprNode.BinaryOpNode(el, op, er); :}
        | expr_rel:er
            {: RESULT = er; :}
;

expr_rel ::= expr_rel:er op_rel:op expr_arit:ea
            {: RESULT = new ExprNode.BinaryOpNode(er, op, ea); :}
        | expr_arit:ea
            {: RESULT = ea; :}
;

expr_arit ::= expr_arit:ea op_arit:op terme:t
            {: RESULT = new ExprNode.BinaryOpNode(ea, op, t); :}
        | terme:t
            {: RESULT = t; :}
;

terme ::= VALOR_LOGIC:vl
            {: RESULT = new ExprNode.LiteralNode(vl, vlleft, vlright); :}
        | ENTER:e
            {: RESULT = new ExprNode.LiteralNode(e, eleft, eright); :}
        | ID:id index_opt:i
            {: RESULT = new ExprNode.VarNode(id, i, idleft, idright); :}
        | CADENA:c
            {: RESULT = new ExprNode.LiteralNode(c, cleft, cright); :}
        | CARACTER:c
            {: RESULT = new ExprNode.LiteralNode(c, cleft, cright); :}
        | call:c
            {: RESULT = new ExprNode.ExprInstrNode(c); :}
        | OBR_PAR expr:e TANC_PAR
            {: RESULT = e; :}
        | OBR_CORX:o expr_list:e TANC_CORX
            {: RESULT = new ExprNode.TupleNode(e, oleft, oright); :}
        | NOT:n expr:e
            {: RESULT = new ExprNode.UnaryOpNode("NOT", e, nleft, nright); :}
;

index_opt ::= OBR_CORX:o expr:e TANC_CORX
            {: RESULT = e; :}
        | /* buit */
            {: RESULT = null; :}
;

expr_list ::= expr:e COMA expr_list:el
            {: RESULT = combinar(e, el); :}
            | expr:e
                {: RESULT = crearLlista(e); :}
            | /* buit */
            {: RESULT = new ArrayList<ExprNode>(); :}
;

op_arit ::= PLUS
            {: RESULT = "+"; :}
        | MINUS
            {: RESULT = "-"; :}
        | TIMES
            {: RESULT = "*"; :}
        | DIVIDE
            {: RESULT = "/"; :}
;

op_rel ::= EQ
            {: RESULT = "=="; :}
        | NE
            {: RESULT = "!="; :}
        | LT
            {: RESULT = "<"; :}
        | LE
            {: RESULT = "<="; :}
        | GT
            {: RESULT = ">"; :}
        | GE
            {: RESULT = ">="; :}
;

op_log ::= AND
            {: RESULT = "i"; :}
        | OR
            {: RESULT = "o"; :}
;