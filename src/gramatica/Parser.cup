/**
 * Assignatura 21742 - Compiladors
 * Estudis: Grau en Informàtica
 * Itinerari: Computació
 * Curs: 2025-2026
 *
 * Professor: Pere Palmer
 *
 * Generar:
 * java -jar java-cup-11b.jar -expect 27 -parser Parser -symbols ParserSym -destdir gen src/gramatica/Parser.cup
 */
import java_cup.runtime.*;
import symbols.*;
import errors.*;
import java.util.*;

class Parser;

parser code {:
    private int line(java_cup.runtime.Symbol s) {
        if(s == null) return safeLine(s);
        return s.left;
    }

    private int column(java_cup.runtime.Symbol s) {
        if (s == null) return safeColumn(s);
        return s.right;
    }

    private int safeLine(Symbol s) {
        return (s != null && s.left >= 0) ? s.left : 0;
    }

    private int safeColumn(Symbol s) {
        return (s != null && s.right >= 0) ? s.right : 0;
    }

    public <T> List<T> combinar(T first, List<T> rest) {
        List<T> list = new ArrayList<>();
        list.add(first);
        if (rest != null) list.addAll(rest);
        return list;
    }

    public <T> List<T> crearLlista(T item) {
        List<T> list = new ArrayList<>();
        list.add(item);
        return list;
    }

    public static SymbolTable currentScope = new SymbolTable(null);
    private TypeNode.Kind auxSwitchType;

    public boolean isInt(TypeNode.Kind t) {
        return (t == TypeNode.Kind.DOUBLE);
    }

    public boolean isBoolean(TypeNode.Kind t) {
        return (t == TypeNode.Kind.BOOLEAN);
    }

    public boolean isString(TypeNode.Kind t) {
        return (t == TypeNode.Kind.STRING);
    }

    public boolean isTuple(TypeNode.Kind t) {
        return (t == TypeNode.Kind.TUPLE);
    }

    public void openScope() {
        currentScope = new SymbolTable(currentScope);
    }

    public void closeScope() {
        if(currentScope.getParent() != null) {
            currentScope = currentScope.getParent();
        } else {
            ErrorManager.add(new CompilerError(CompilerError.TYPE.SEMANTIC,
                "Error intern: intent de tancar l'àmbit global"));
        }
    }
:}

terminal Symbol
            PRINCIPAL, ENDPRINCIPAL,
            OP_IF, OP_THEN, OP_ELSE, OP_ENDIF,
            OP_SWITCH, DEFAULT_SWITCH, OP_ENDSWITCH,
            OP_WHILE, OP_DO, OP_ENDWHILE,
            OP_REP, PROCEDIMENT, ENDPROCEDIMENT,
            FUNCIO, ENDFUNCIO, TORNAR, CONST,
            OP_TIPUS_CADENA, OP_TIPUS_TUPLA, OP_TIPUS_CARACTER,
            OP_TIPUS_ENTER, OP_TIPUS_LOGIC,
            PLUS, MINUS, TIMES, DIVIDE,
            EQ, NE, LT, LE, GT, GE, INPUT, OUTPUT,
            AND, OR, NOT, ASSIGNACIO, OBR_PAR,
            TANC_PAR, OBR_CORX, TANC_CORX, DOS_PUNTS,
            COMA, PUNT_COMA, PUNT, ERROR;

terminal String ID, CADENA;
terminal Character CARACTER;
terminal Double ENTER;
terminal Boolean VALOR_LOGIC;

non terminal ProgramNode program;
non terminal List<DeclNode> decls;
non terminal List<MethodNode> methods;
non terminal List<InstrNode> instrs, optional_cond;
non terminal DeclNode decl;
non terminal InstrNode instr,  entrada, sortida;
non terminal InstrNode.CallNode call;
non terminal CondNode cond;
non terminal CondNode.SwitchNode.CaseNode cas_opcio;
non terminal LoopNode loop;
non terminal MethodNode method;
non terminal TypeNode tipus;
non terminal ExprNode assig, expr, terme;
non terminal ExprNode expr_logic, expr_rel, expr_arit;
non terminal ExprNode.LiteralNode index_opt;
non terminal ArgNode arg;
non terminal List<ArgNode> args;
non terminal List<CondNode.SwitchNode.CaseNode> cas_opcions;
non terminal String op_arit, op_rel, op_log;
non terminal List<ExprNode.VarNode> list_id;
non terminal List<ExprNode> expr_list;

// Associativitat i precedència dels operadors
precedence left OR;            // OR més baix que AND
precedence left AND;           // AND més baix que comparacions

precedence nonassoc EQ, NE, LT, LE, GT, GE;   // comparadors no associatius

precedence left PLUS, MINUS;    // suma i resta associatius a l'esquerra
precedence left TIMES, DIVIDE;  // multiplicació i divisió associatius a l'esquerra

precedence right NOT;          // negació (NOT) té associativitat a la dreta

start with program;

program ::= PRINCIPAL:p ID:id DOS_PUNTS decls:d methods:m instrs:i ENDPRINCIPAL
            {:
                RESULT = new ProgramNode(id, d, m, i, line(p), column(p));
            :}
;

decls ::= decl:d decls:ds
            {:
                RESULT = combinar(d, ds);
            :}
        | /* buit */
            {:
                RESULT = new ArrayList<DeclNode>();
            :}
;

decl ::= tipus:t list_id:l assig:a
            {:
                DeclNode d = new DeclNode(false, t, l, a);

                for(ExprNode.VarNode var : l) {
                    Simbol s = new Simbol(var.getName(), d.type, d.isConst, var.line, var.column);

                    if(isTuple(t.getKind())) {
                        if (a == null) {
                            ErrorManager.add(new CompilerError(var.line, var.column, CompilerError.TYPE.SEMANTIC,
                                    "Les tuples s'han d'inicialitzar en el moment de la declaració " + var.getName()));
                        } else if (a instanceof ExprNode.TupleNode tupleNode) {
                            s.setTupleCamps(tupleNode.getElements());
                        }
                    }

                    // Comprovació de tipus si hi ha assignació
                    if (a != null && !d.type.getKind().equals(a.getKind())) {
                        if (isTuple(a.getKind()) && a instanceof ExprNode.VarNode varNode && varNode.getIndex() != Integer.MIN_VALUE) {
                            Simbol tupla = currentScope.lookUp(varNode.getName());

                            if (tupla != null) {
                                List<ExprNode> llista = tupla.getTupleCamps();
                                int index = varNode.getIndex();
                                if (index >= 0 && index < llista.size()) {
                                    TypeNode.Kind tipusElement = llista.get(index).getKind();
                                    if (!t.getKind().equals(tipusElement)) {
                                        ErrorManager.add(new CompilerError(var.line, var.column, CompilerError.TYPE.SEMANTIC,
                                            "Tipus incompatible a l'assignació: variable " + var.getName() +
                                            " és " + t.getKind() + " i s'hi assigna " + tipusElement));
                                    }
                                } else {
                                    ErrorManager.add(new CompilerError(var.line, var.column, CompilerError.TYPE.SEMANTIC,
                                        "L'índex està defora del rang definit per la tupla: [0," + (llista.size() - 1) + "]"));
                                }
                            }
                        } else {
                            ErrorManager.add(new CompilerError(var.line, var.column, CompilerError.TYPE.SEMANTIC,
                                        "Tipus incompatible a l'assignació: variable " + var.getName() + " és " +
                                        t.getKind() + " i s'hi assigna " + a.getKind()));
                        }
                    }

                    if (!currentScope.add(s)) {
                        ErrorManager.add(new CompilerError(var.line, var.column, CompilerError.TYPE.SEMANTIC,
                            "Variable ja declarada: " + var.getName()));
                    }
                }
                RESULT = d;
            :}
        | CONST:c tipus:t list_id:l ASSIGNACIO expr:e
            {:
                DeclNode d = new DeclNode(true, t, l, e, line(c), column(c));

                for(ExprNode.VarNode var : l) {
                    Simbol s = new Simbol(var.getName(), d.type, d.isConst, var.line, var.column);

                    if (!currentScope.add(s)) {
                        ErrorManager.add(new CompilerError(var.line, var.column, CompilerError.TYPE.SEMANTIC,
                            "Constant ja declarada: " + var.getName()));
                    }
                }
                RESULT = d;
            :}
;

methods ::= method:m methods:ms
            {:
                RESULT = combinar(m, ms);
            :}
        | /* buit */
            {:
                RESULT = new ArrayList<MethodNode>();
            :}
;

method ::= FUNCIO:f tipus:t ID:id OBR_PAR args:a TANC_PAR
            {:
                int lin = line(f);
                int col = column(f);

                Simbol s = new Simbol(id, t, false, Simbol.Methods.FUNCIO, lin, col, a);

                if (!currentScope.add(s)) {
                    ErrorManager.add(new CompilerError(lin, col, CompilerError.TYPE.SEMANTIC,
                        "Nom ja utilitzat: " + id));
                }

                openScope();

                for (ArgNode arg : a) {
                    String name = arg.getVar().getName();
                    TypeNode type = arg.getType();
                    Simbol sA = new Simbol(name, type, false, lin, col);

                    if(!currentScope.add(sA)) {
                        ErrorManager.add(new CompilerError(arg.getVar().line, arg.getVar().column, CompilerError.TYPE.SEMANTIC,
                                    "Argument ja declarat: " + name));
                    }
                }
            :}
          DOS_PUNTS:dp decls:d instrs:i TORNAR expr:e ENDFUNCIO
            {:
                if(!e.getKind().equals(t.getKind())) {
                    ErrorManager.add(new CompilerError(line(dp), column(dp), CompilerError.TYPE.SEMANTIC,
                                    "El tipus del retorn " + e.getKind() +
                                    " no coincideix amb el tipus de la funció: " + t.getKind()));
                }

                MethodNode m = new MethodNode(true, id, t, a, d, i, e, line(f), column(f), currentScope);
                closeScope();

                RESULT = m;
            :}
        | PROCEDIMENT:p ID:id OBR_PAR args:a TANC_PAR
            {:
                int lin = line(p);
                int col = column(p);

                Simbol s = new Simbol(id, null, false, Simbol.Methods.PROCEDIMENT, lin, col, a);
                if (!currentScope.add(s)) {
                    ErrorManager.add(new CompilerError(lin, col, CompilerError.TYPE.SEMANTIC,
                        "Nom ja utilitzat: " + id));
                }

                openScope();

                for (ArgNode arg : a) {
                    String name = arg.getVar().getName();
                    TypeNode type = arg.getType();
                    Simbol sA = new Simbol(name, type, false, lin, col);

                    if(!currentScope.add(sA)) {
                        ErrorManager.add(new CompilerError(arg.getVar().line, arg.getVar().column, CompilerError.TYPE.SEMANTIC,
                                    "Argument ja declarat: " + name));
                    }
                }
            :}
         DOS_PUNTS decls:d instrs:i ENDPROCEDIMENT
            {:
                MethodNode m = new MethodNode(true, id, null, a, d, i, null, line(p), column(p), currentScope);
                closeScope();

                RESULT = m;
            :}
;

instrs ::= instr:i instrs:is
            {:
                RESULT = combinar(i, is);
            :}
        | /* buit */
            {:
                RESULT = new ArrayList<InstrNode>();
            :}
;

instr ::= call:c
            {:
                RESULT = c;
            :}
        | cond:c
            {:
                RESULT = c;
            :}
        | loop:l
            {:
                RESULT = l;
            :}
        | entrada:e
            {:
                RESULT = e;
            :}
        | sortida:s
            {:
                RESULT = s;
            :}
        | ID:id ASSIGNACIO expr:e
            {:
                Simbol s = currentScope.lookUp(id);
                if (s == null) {
                    ErrorManager.add(new CompilerError(e.line, e.column, CompilerError.TYPE.SEMANTIC,
                                        "Variable no declarada: " + id));
                } else {
                    // Comprovar tipus
                    if (!s.getType().getKind().equals(e.getKind())) {
                        ErrorManager.add(new CompilerError(e.line, e.column, CompilerError.TYPE.SEMANTIC,
                            "Tipus incompatible a l'assignació: variable " + id +
                            " és " + s.getType().getKind() + " i s'hi assigna " + e.getKind()));
                    }

                    // Comprovar constant
                    if (s.isConst()) {
                        ErrorManager.add(new CompilerError(e.line, e.column, CompilerError.TYPE.SEMANTIC,
                            "No es pot assignar a una constant: " + id));
                    }

                    s.setInitialized(true);

                    DeclNode d = new DeclNode(false, s.getType(), crearLlista(new ExprNode.VarNode(id)), e);
                    RESULT = new InstrNode.InstrDeclNode(d);
                }
            :}
        | decl:d
            {:
                RESULT = new InstrNode.InstrDeclNode(d);
            :}
;

call ::= ID:id OBR_PAR:op expr_list:e TANC_PAR
            {:
                int lin = line(op);
                int col = column(op);

                InstrNode.CallNode c = new InstrNode.CallNode(id, e, lin, col);

                Simbol s = currentScope.lookUp(id);
                if (s == null) {
                    ErrorManager.add(new CompilerError(lin, col, CompilerError.TYPE.SEMANTIC,
                        "Mètode no declarat: " + id));
                } else if (s.getMethodType() == Simbol.Methods.NONE) {
                    ErrorManager.add(new CompilerError(lin, col, CompilerError.TYPE.SEMANTIC,
                    id + " no és un mètode."));
                } else {
                    List<ArgNode> params = s.getParams();

                    if (params == null) params = new ArrayList<>();

                    if(params.size() != e.size()) {
                        ErrorManager.add(new CompilerError(lin, col, CompilerError.TYPE.SEMANTIC,
                                                    "Nombre d'arguments incorrecte a la crida de " + id +
                                                    ": s'esperaven " + params.size() +
                                                    " i s'han passat " + e.size()));
                    } else {
                        for (int i = 0; i < params.size(); i++) {
                            TypeNode.Kind esperat = params.get(i).getType().getKind();
                            TypeNode.Kind rebut = e.get(i).getKind();

                            if (rebut == null || esperat != rebut) {
                                ErrorManager.add(new CompilerError(
                                                    e.get(i).line,
                                                    e.get(i).column,
                                                    CompilerError.TYPE.SEMANTIC,
                                                    "Tipus incorrecte a l'argument " + (i + 1) +
                                                    " de la crida a " + id + ": s'esperava " +
                                                    esperat + " i s'ha rebut " + rebut));
                            }

                        }
                    }
                }

                RESULT = c;
            :}
;

cond ::= OP_IF:op OBR_PAR expr:e TANC_PAR
            {:
                openScope();

                if (!isBoolean(e.getKind())) {
                    ErrorManager.add(new CompilerError(line(op), column(op), CompilerError.TYPE.SEMANTIC,
                        "La condició del 'if' ha de ser de tipus booleà, trobat: " + e.getKind()));
                }
            :}
          OP_THEN instrs:i optional_cond:o
            {:
                CondNode.IfNode if_node = new CondNode.IfNode(e, i, o, line(op), column(op));
                closeScope();

                RESULT = if_node;
            :}
        | OP_SWITCH:op ID:id DOS_PUNTS
            {:
                Simbol s = currentScope.lookUp(id);
                if (s == null) {
                    ErrorManager.add(new CompilerError(line(op), column(op), CompilerError.TYPE.SEMANTIC,
                        "Variable no declarada al 'switch': " + id));
                }

                openScope();

                auxSwitchType = (s != null) ? s.getType().getKind() : TypeNode.Kind.NULL;
            :}
          cas_opcions:c DEFAULT_SWITCH DOS_PUNTS instrs:i OP_ENDSWITCH
            {:
                closeScope();
                RESULT = new CondNode.SwitchNode(id, c, i, line(op), column(op));
            :}
;

optional_cond ::= OP_ELSE
            {:
                openScope();
            :}
          instrs:i OP_ENDIF
            {:
                closeScope();
                RESULT = i;
            :}
        | OP_ENDIF
            {:
                RESULT = null;
            :}
;

cas_opcions ::= cas_opcio:c cas_opcions:cs
            {:
                RESULT = combinar(c, cs);
            :}
        | cas_opcio:c
            {:
                RESULT = crearLlista(c);
            :}
;

cas_opcio ::= terme:t DOS_PUNTS:d instrs:i
            {:
                TypeNode.Kind caseType = t.getKind();

                if (auxSwitchType != TypeNode.Kind.NULL && auxSwitchType != caseType) {
                    ErrorManager.add(new CompilerError(line(d), column(d), CompilerError.TYPE.SEMANTIC,
                        "Tipus incompatible al 'case': esperat " + auxSwitchType + " però trobat " + caseType));
                }

                RESULT = new CondNode.SwitchNode.CaseNode(t, i, line(d), column(d));
            :}
;

loop ::= OP_WHILE:w OBR_PAR expr:e TANC_PAR
            {:
                if (!isBoolean(e.getKind())) {
                    ErrorManager.add(new CompilerError(
                        line(w), column(w), CompilerError.TYPE.SEMANTIC,
                        "La condició del 'while' ha de ser de tipus booleà, trobat: " + e.getKind()
                    ));
                }

                openScope();
            :}
          OP_DO instrs:i OP_ENDWHILE
            {:
                closeScope();

                RESULT = new LoopNode.WhileNode(e, i, line(w), column(w));
            :}
        | OP_DO:d
            {:
                openScope();
            :}
          instrs:i OP_REP OBR_PAR expr:e TANC_PAR
            {:
                closeScope();

                if(!isBoolean(e.getKind())) {
                    ErrorManager.add(new CompilerError(line(d), column(d), CompilerError.TYPE.SEMANTIC,
                        "La condició del 'do-while' ha de ser de tipus booleà, trobat: " + e.getKind()));
                }

                RESULT = new LoopNode.DoWhileNode(i, e, line(d), column(d));
            :}
;

entrada ::= INPUT:i OBR_PAR ID:id TANC_PAR
            {:
                Simbol s = currentScope.lookUp(id);

                if(s == null) {
                    ErrorManager.add(new CompilerError(line(i), column(i), CompilerError.TYPE.SEMANTIC,
                        "Variable " + id + " no declarada"));
                }

                RESULT = new InstrNode.InputNode(id, line(i), column(i));
            :}
;

sortida ::= OUTPUT:o OBR_PAR expr:e TANC_PAR
            {:
                RESULT = new InstrNode.OutputNode(e, line(o), column(o));
            :}
;

tipus ::= OP_TIPUS_ENTER:op
            {:
                RESULT = new TypeNode(TypeNode.Kind.DOUBLE, line(op), column(op));
            :}
        | OP_TIPUS_CADENA:op
            {:
                RESULT = new TypeNode(TypeNode.Kind.STRING, line(op), column(op));
            :}
        | OP_TIPUS_CARACTER:op
            {:
                RESULT = new TypeNode(TypeNode.Kind.CHARACTER, line(op), column(op));
            :}
        | OP_TIPUS_LOGIC:op
            {:
                RESULT = new TypeNode(TypeNode.Kind.BOOLEAN, line(op), column(op));
            :}
        | OP_TIPUS_TUPLA:op
            {:
                RESULT = new TypeNode(TypeNode.Kind.TUPLE, line(op), column(op));
            :}
;

list_id ::= ID:id COMA list_id:l
            {:
                RESULT = combinar(new ExprNode.VarNode(id), l);
            :}
        | ID:id
            {:
                RESULT = crearLlista(new ExprNode.VarNode(id));
            :}
;

args ::= arg:a COMA args:as
            {:
                RESULT = combinar(a, as);
            :}
        | arg: a
            {:
                RESULT = crearLlista(a);
            :}
        | /* buit */
            {:
                RESULT = new ArrayList<ArgNode>();
            :}
;

arg ::= ID:id DOS_PUNTS tipus:t
            {:
                RESULT = new ArgNode(new ExprNode.VarNode(id), t);
            :}
;

assig ::= ASSIGNACIO expr:e
            {:
                RESULT = e;
            :}
        | /* buit */
            {:
                RESULT = null;
            :}
;

expr ::= expr_logic:e
            {:
                RESULT = e;
            :}
;

expr_logic ::= expr_logic:el op_log:op expr_rel:er
            {:
                ExprNode.BinaryOpNode bin = new ExprNode.BinaryOpNode(el, op, er);
                int lin = bin.line;
                int col = bin.column;

                TypeNode.Kind t_left = el.getKind();
                TypeNode.Kind t_right = er.getKind();

                // Comprovació de tipus lògic
                if (!isBoolean(t_left) || !isBoolean(t_right)) {
                    ErrorManager.add(new CompilerError(lin, col,
                        CompilerError.TYPE.SEMANTIC,
                        "Operació lògica només permesa entre booleans (" + t_left + " " + op + " " + t_right + ")"));
                    bin.setKind(TypeNode.Kind.BOOLEAN);
                } else {
                    bin.setKind(TypeNode.Kind.BOOLEAN);
                }

                RESULT = bin;
            :}
        | expr_rel:er
            {:
                RESULT = er;
            :}
;

expr_rel ::= expr_rel:er op_rel:op expr_arit:ea
            {:
                ExprNode.BinaryOpNode bin = new ExprNode.BinaryOpNode(er, op, ea);
                int lin = bin.line;
                int col = bin.column;

                TypeNode.Kind t_left = er.getKind();
                TypeNode.Kind t_right = ea.getKind();

                if (op.equals("==") || op.equals("!=")) {
                    // == i != per tots els literals
                    bin.setKind(TypeNode.Kind.BOOLEAN);
                } else {
                    // <, <=, >, >= només amb enters
                    if (isInt(t_left) && isInt(t_right)) {
                        bin.setKind(TypeNode.Kind.BOOLEAN);
                    } else {
                        // Qualsevol altre tipus amb aquests operadors és error
                        ErrorManager.add(new CompilerError(lin, col, CompilerError.TYPE.SEMANTIC,
                            "Operador relacional '" + op + "' només permès amb enters (" +
                            t_left + " " + op + " " + t_right + ")"));
                        bin.setKind(TypeNode.Kind.BOOLEAN); // permetre continuar parsing
                    }
                }

                RESULT = bin;
            :}
        | expr_arit:ea
            {:
                RESULT = ea;
            :}
;

expr_arit ::= expr_arit:ea op_arit:op terme:t
            {:
                ExprNode.BinaryOpNode bin = new ExprNode.BinaryOpNode(ea, op, t);
                int lin = bin.line;
                int col = bin.column;

                // Comprovació de tipus aritmètic
                if (!isInt(ea.getKind()) || !isInt(t.getKind())) {
                    ErrorManager.add(new CompilerError(lin, col,
                        CompilerError.TYPE.SEMANTIC,
                        "Operació aritmètica només permesa entre enters (" + ea.getKind() + " " + op + " " + t.getKind() + ")"));
                    bin.setKind(TypeNode.Kind.DOUBLE); // per evitar propagació d'error
                } else {
                    bin.setKind(TypeNode.Kind.DOUBLE);
                }

                RESULT = bin;
            :}
        | terme:t
            {:
                RESULT = t;
            :}
;

terme ::= VALOR_LOGIC:vl
            {:
                RESULT = new ExprNode.LiteralNode(vl);
            :}
        | ENTER:e
            {:
                RESULT = new ExprNode.LiteralNode(e);
            :}
        | ID:id index_opt:i
            {:
                ExprNode.VarNode var = new ExprNode.VarNode(id);
                Simbol s = currentScope.lookUp(id);

                if (s == null) {
                    ErrorManager.add(new CompilerError(0, 0, CompilerError.TYPE.SEMANTIC,
                                    "Variable no declarada: " + id));
                } else if (!isTuple(s.getType().getKind()) && i != null) {
                    ErrorManager.add(new CompilerError(0, 0, CompilerError.TYPE.SEMANTIC,
                                    "La variable no és de tipus " + TypeNode.Kind.TUPLE + ", tipus trobat: " +
                                    s.getType().getKind()));
                } else {
                    var.setKind(s.getType().getKind());
                    if (i != null) var.setIndex((Double)i.getValue());
                }

                RESULT = var;
            :}
        | CADENA:c
            {:
                RESULT = new ExprNode.LiteralNode(c);
            :}
        | CARACTER:c
            {:
                RESULT = new ExprNode.LiteralNode(c);
            :}
        | call:c
            {:
                ExprNode.ExprInstrNode expr = new ExprNode.ExprInstrNode(c);
                Simbol s = currentScope.lookUp(c.functionName);
                if (s == null) {
                    ErrorManager.add(new CompilerError(c.line, c.column, CompilerError.TYPE.SEMANTIC,
                        "Crida a mètode no declarat: " + c.functionName));
                } else if (s.getMethodType() == Simbol.Methods.PROCEDIMENT) {
                    ErrorManager.add(new CompilerError(c.line, c.column, CompilerError.TYPE.SEMANTIC,
                        "Un procediment no pot aparèixer dins una expressió: " + c.functionName));
                } else {
                    expr.setKind(s.getType().getKind());
                }

                RESULT = expr;
            :}
        | OBR_PAR expr:e TANC_PAR
            {:
                RESULT = e;
            :}
        |OBR_PAR:o expr_list:e TANC_PAR
            {:
                RESULT = new ExprNode.TupleNode(e, line(o), column(o));
            :}
        | NOT:n expr:e
            {:
                ExprNode.UnaryOpNode un = new ExprNode.UnaryOpNode("NOT", e, line(n), column(n));

                if (!isBoolean(e.getKind())) {
                    ErrorManager.add(new CompilerError(line(n), column(n),
                                        CompilerError.TYPE.SEMANTIC,
                                        "L'operador 'NOT' només pot aplicar-se sobre valors booleans"));
                }

                un.setKind(TypeNode.Kind.BOOLEAN);

                RESULT = un;
            :}
;

index_opt ::= OBR_CORX:o ENTER:e TANC_CORX
            {:
                RESULT = new ExprNode.LiteralNode(e, line(o), column(o));
            :}
        | /* buit */
            {:
                RESULT = null;
            :}
;

expr_list ::= expr:e COMA expr_list:el
            {:
                RESULT = combinar(e, el);
            :}
        | expr:e
            {:
                RESULT = crearLlista(e);
            :}
        | /* buit */
            {:
                RESULT = new ArrayList<ExprNode>();
            :}
;

op_arit ::= PLUS
            {: RESULT = "+"; :}
        | MINUS
            {: RESULT = "-"; :}
        | TIMES
            {: RESULT = "*"; :}
        | DIVIDE
            {: RESULT = "/"; :}
;

op_rel ::= EQ
            {: RESULT = "=="; :}
        | NE
            {: RESULT = "!="; :}
        | LT
            {: RESULT = "<"; :}
        | LE
            {: RESULT = "<="; :}
        | GT
            {: RESULT = ">"; :}
        | GE
            {: RESULT = ">="; :}
;

op_log ::= AND
            {: RESULT = "i"; :}
        | OR
            {: RESULT = "o"; :}
;










